flowchart TD
    subgraph TRAIN["TRAINING FLOW"]
        A1["Upload labeled doc"] --> B1["extract_text()"]
        B1 --> C1["Assign Category + Subcategory\n+ Keywords"]
        C1 --> D1["add_training_sample()\n→ training_data.json"]
        D1 --> E1{"Enough\nsamples?"}
        E1 -- Yes --> F1["prepare_training_texts()\n+ preprocess + keyword boost"]
        F1 --> G1["InsuranceClassifier.train()\nfit pipeline + cross-validate"]
        G1 --> H1["save()\n→ classifier.joblib"]
    end
    subgraph PREDICT["PREDICTION FLOW"]
        A2["Upload unknown doc"] --> B2["extract_text()"]
        B2 --> C2["prepare_single_text()\n+ optional keywords"]
        C2 --> D2["load classifier.joblib\n(auto on startup)"]
        D2 --> E2["predict_top_n(n=5)\npredict_proba → argsort"]
        E2 --> F2["Display top-5 results\nwith confidence scores"]
    end
    H1 -.->|model loaded| D2
